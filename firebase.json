{
  "hosting": {
    "public": "static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/model",
        "destination": "/api/model.json"
      },
      {
        "source": "/api/health",
        "destination": "/api/health.json"
      },
      {
        "source": "/api/update",
        "destination": "/api/update.json"
      },
      {
        "source": "/api/dashboard",
        "destination": "/api/dashboard.json"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      }
    ]
  }
}
